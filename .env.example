# ─── Supabase ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here       # service-role — backend only, NEVER expose to frontend
SUPABASE_ANON_KEY=your-anon-key-here           # public — sent from frontend
# Optional but RECOMMENDED for defense in depth: lets backend verify JWT
# signatures locally instead of trusting Supabase's downstream rejection.
# Get from Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# ─── App ───
APP_ENV=development                            # set to "production" on Render to disable X-Dev-User-Id backdoor
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ─── External services ───
GROQ_API_KEY=
MAILGUN_API_KEY=
MAILGUN_SIGNING_KEY=
RESEND_API_KEY=
RESEND_FROM=                                   # e.g. "Klaser <noreply@yourdomain.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ─── Cron ───
CRON_SECRET=                                   # random ≥32-char string; also stored as GitHub Actions secret
